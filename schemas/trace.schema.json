    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "answer": "#/$defs/AnswerEvent",
            "cite": "#/$defs/CiteEvent",
            "think": "#/$defs/ThinkEvent",
            "tool": "#/$defs/ToolEvent",
            "verify": "#/$defs/VerifyEvent"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ThinkEvent"
          },
          {
            "$ref": "#/$defs/ToolEvent"
          },
          {
            "$ref": "#/$defs/AnswerEvent"
          },
          {
            "$ref": "#/$defs/CiteEvent"
          },
          {
            "$ref": "#/$defs/VerifyEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "header": {
      "$ref": "#/$defs/TraceHeader"
    },
    "schema": {
      "const": "safetypage.trace/1",
      "default": "safetypage.trace/1",
      "title": "Schema",
      "type": "string"
    },
    "scores": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Scores",
      "type": "object"
    }
