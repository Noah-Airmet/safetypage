          "title": "Cite",
          "type": "string"
        },
        "cite_id": {
          "title": "Cite Id",
          "type": "string"
        },
        "gold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "unresolved",
                "unseen",
                "quote_elsewhere",
                "quote_near_miss",
                "quote_not_found",
                "unsupported"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "verified",
            "cited",
            "rejected"
