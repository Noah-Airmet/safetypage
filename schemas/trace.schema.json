          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "title": "T Ms",
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "t_ms",
        "delta"
      ],
      "title": "AnswerEvent",
      "type": "object"
    },
    "CiteEvent": {
      "additionalProperties": false,
