        "doc_id",
        "title",
        "url",
        "authors",
        "org",
        "kind",
        "collection",
        "published",
        "source_url",
        "version",
        "versions",
        "tier",
        "licence",
        "anchor_kind",
        "fidelity",
        "unit_count",
        "outline"
