          "type": "string"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
