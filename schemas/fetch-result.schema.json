            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
