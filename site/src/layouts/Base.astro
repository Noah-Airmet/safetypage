---
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/hanken-grotesk/wght-italic.css';
import '@fontsource/fragment-mono/400.css';
// The dark theme's faces (a browser fetches a face only when a theme uses it).
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';

interface Props { title?: string; description?: string; og?: string; canonical?: string; bare?: boolean; wide?: boolean; find?: boolean }
const { title, description = 'A library of the AI safety record. Every result opens the exact page, and every citation is checked against it.', og = '/og/site.png', canonical, bare, wide, find = true } = Astro.props;
const fullTitle = title ? `${title} · SafetyPage` : 'SafetyPage: the AI safety record, cited to the page';
// A page is built as <address>.html; its address has no extension.
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const nav = [
  ['/library', 'Library'], ['/search', 'Search'], ['/follow', 'Follow'], ['/check', 'Check'], ['/citationbench', 'CitationBench'], ['/connect', 'Connect'],
];
const current = (href: string) => (here === href || here.startsWith(href + '/') ? 'page' : undefined);
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(canonical ?? here)} />
    <meta property="og:site_name" content="SafetyPage" />
    <meta property="og:title" content={title ?? 'SafetyPage'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={abs(canonical ?? here)} />
    <meta property="og:image" content={abs(og)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(og)} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eceef1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
    <script is:inline>try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect class="wm-page" x="3.75" y="1.75" width="12.5" height="16.5" rx="1.75" /><rect class="wm-mark" x="6" y="8" width="8" height="4" rx=".75" /></svg>
          SafetyPage
        </a>
        <nav class="nav" aria-label="Site">
          {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
        </nav>
        {find && (
          <form class="bar-find" action="/search" role="search">
            <Icon name="search" small />
            <input class="field" type="search" name="query" placeholder="Search" aria-label="Search the library" autocomplete="off" />
          </form>
        )}
        <details class="menu">
          <summary aria-label="Menu"><Icon name="menu" /></summary>
          <nav aria-label="Site">
            {nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main style={wide ? '--page: 1500px' : undefined}><slot /></main>
    {!bare && (
      <footer class="foot">
        <div class="wrap foot-in">
          <a href="/about">How it works</a>
          <a href="/about#licences">Licences</a>
          <a href="/r">Replays</a>
          <a href="https://github.com/Noah-Airmet/safetypage">GitHub</a>
          <span class="by">Noah Airmet</span>
          <div class="seg theme" role="radiogroup" aria-label="Theme">
            <button type="button" role="radio" data-theme-set="auto">Auto</button>
            <button type="button" role="radio" data-theme-set="light">Light</button>
            <button type="button" role="radio" data-theme-set="dark">Dark</button>
          </div>
        </div>
      </footer>
    )}
    <script>
      // Copy: the control says so with the drawn check, or the word, on the press itself.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLElement>('[data-copy]');
        if (button) {
          navigator.clipboard.writeText(button.dataset.copy!);
          const use = button.querySelector('use');
          const was = use ? use.getAttribute('href')! : button.textContent!;
          if (use) use.setAttribute('href', '/icons.svg#check');
          else button.textContent = 'Copied';
          setTimeout(() => (use ? use.setAttribute('href', was) : (button.textContent = was)), 1200);
        }
        // A menu closes on a press outside it.
        document.querySelectorAll<HTMLDetailsElement>('details.menu[open], details.contents[open], details.pop[open]').forEach((d) => {
          if (!d.contains(target)) d.removeAttribute('open');
        });
      });
      // The theme follows the system; the footer's switch overrides it on this device.
      const themeButtons = document.querySelectorAll<HTMLElement>('[data-theme-set]');
      const showTheme = () => themeButtons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeSet === (document.documentElement.dataset.theme ?? 'auto'))));
      themeButtons.forEach((b) => b.addEventListener('click', () => {
        const to = b.dataset.themeSet!;
        if (to === 'auto') { delete document.documentElement.dataset.theme; localStorage.removeItem('theme'); }
        else { document.documentElement.dataset.theme = to; localStorage.setItem('theme', to); }
        showTheme();
      }));
      showTheme();
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') document.querySelectorAll('details.menu[open], details.contents[open], details.pop[open]').forEach((d) => d.removeAttribute('open'));
        // "/" searches from anywhere.
        const field = document.querySelector<HTMLElement>('.composer textarea, .ask input, .bar-find input');
        if (event.key === '/' && field && !(event.target as HTMLElement).closest('input, textarea, select')) { event.preventDefault(); field.focus(); }
      });
    </script>
  </body>
</html>
