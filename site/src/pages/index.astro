---
import Base from '../layouts/Base.astro';
import PageCrop from '../components/PageCrop.astro';
import Tally from '../components/Tally.astro';
import Icon from '../components/Icon.astro';
import { allRuns, allShelves, featuredTrace, getDoc, getUnit, libraryCounts } from '../lib/data';
import { KINDS, anchorLabel, citePath, formatDate, questionParts, shelfName, shelfOrder, shortLabel } from '../lib/cite';
import { EXAMPLE, landingChecks } from '../lib/checks';
import { TOPICS, follow } from '../lib/follow';
import { spanInUnit } from '../lib/quote';
import { mcpUrl } from '../lib/env';

// The example is checked by the server when the site is built: what is printed here is its answer.
const { verified, rejected } = await landingChecks();
const doc = getDoc(EXAMPLE.cite.split('/')[0])!;
const n = libraryCounts();
const num = (x: number) => x.toLocaleString('en');
const where = verified.locations[0];
const unit = getUnit(where.cite)!;
const label = `${shortLabel(doc)}, ${anchorLabel(where.anchor)}`;
const found = spanInUnit(unit, [where.spine_start, where.spine_end])!;
const near = rejected.locations[0];
const nearRange = spanInUnit(unit, [near.spine_start, near.spine_end])!;
const missing = rejected.segments[0].diff.filter((d) => d.op === 'insert').map((d) => d.source);
// The source's wording with the words the quotation dropped marked.
const sourceWords = near.text.replace(/\s+/g, ' ').split(' ');
const trace = featuredTrace();
const asked = trace && questionParts(trace.header.question);
const runs = allRuns();
const connect = `claude mcp add --transport http safetypage ${mcpUrl(Astro.site!.origin)}`;
const shelves = [...allShelves()].sort((a, b) => shelfOrder(a.id) - shelfOrder(b.id) || b.docs.length - a.docs.length);
const topics = (await Promise.all(TOPICS.map(follow))).filter((t) => t.found > 0);
// Search examples are shown only when the library has what they look for.
const examples = n.documents > 1000 ? ['"alignment faking"', 'sabotage evaluation', 'sparse autoencoder*', 'sycophancy NEAR/10 evaluation'] : ['"risk assessment" evaluation', 'sparse autoencoder features', 'risk tolerance'];
// The newest lab documents; on a small library, the newest of anything.
const recent = (shelves.find((s) => s.id === 'labs') ?? shelves[0]).docs.slice(0, 7);
---
<Base find={false}>
  <section class="wrap hero" data-proof data-show="verified">
    <div class="hero-say">
      <h1 class="sr">SafetyPage</h1>
      <div class="hero-find">
        <form class="composer" action="/search" role="search" data-composer>
          <div class="cbox">
            <input type="search" name="query" placeholder={`Search ${num(n.documents)} AI safety documents`} aria-label="Search the library" autocomplete="off" />
            <button class="send" aria-label="Search"><Icon name="send" /></button>
          </div>
        </form>
        <p class="tries">{examples.map((q) => <a href={`/search?query=${encodeURIComponent(q)}`}>{q}</a>)}</p>
      </div>
      <div class="claims">
        <button class="claim" data-pick="verified" aria-pressed="true">
          <q>{verified.quote}</q>
          <span class="claim-foot">
            <span class="chip" data-state="verified"><span class="sr">Verified: </span><span class="chip-label">{label}</span></span>
            <span class="state" data-state="verified">On {anchorLabel(where.anchor)}, word for word</span>
          </span>
        </button>
        <button class="claim" data-pick="rejected" aria-pressed="false">
          <q>{rejected.quote}</q>
          <span class="claim-foot">
            <span class="chip" data-state="rejected"><span class="sr">Rejected: </span><span class="chip-label">{label}</span></span>
            <span class="state" data-state="rejected">Not on {anchorLabel(near.anchor)}</span>
          </span>
          <span class="says">{anchorLabel(near.anchor)}: “{sourceWords.map((w, i) => <>{i > 0 && ' '}{missing.includes(w) ? <ins class="diff">{w}</ins> : w}</>)}”</span>
        </button>
      </div>
    </div>
    <figure class="hero-page">
      <div data-pane="verified"><PageCrop unit={unit} ranges={[found]} alt={`${doc.title}, ${anchorLabel(where.anchor)}, with the quoted passage highlighted`} eager /></div>
      <div data-pane="rejected"><PageCrop unit={unit} ranges={[nearRange]} at={[found]} kind="reject" alt={`${doc.title}, ${anchorLabel(near.anchor)}, with the sentence the quotation misquotes underlined`} /></div>
      <figcaption class="caption"><span>{doc.title}, {anchorLabel(where.anchor)} of {doc.unit_count}</span><a class="link" href={citePath(where.cite, verified.quote)}>Open the page</a></figcaption>
    </figure>
  </section>

  <div class="wrap">
    <section class="section split">
      <div>
        <h2 class="h2" id="shelves-h"><a href="/library">Library</a></h2>
        <div class="rows shelflist" aria-labelledby="shelves-h">
          {shelves.map((s) => <a href={`/library/${s.id}`}><span class="name">{shelfName(s.id)}</span><span class="val">{num(s.docs.length)}</span></a>)}
        </div>
      </div>
      <div>
        <h2 class="h2" id="recent-h">New from the labs</h2>
        <div class="rows" aria-labelledby="recent-h">
          {recent.map((d) => (
            <a href={citePath(d.doc_id)}>
              <span class="name">{d.title}</span>
              <span class="sub">{[d.authors.length ? shortLabel(d).replace(/ \d{4}$/, '') : d.org, KINDS[d.kind] ?? d.kind].filter(Boolean).join(', ')}</span>
              <span class="val">{formatDate(d.published).replace(/^\d+ /, '')}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {topics.length > 0 && (
      <section class="section" aria-labelledby="follow-h">
        <h2 class="h2" id="follow-h"><a href="/follow">Follow</a></h2>
        <div class="topics">
          {topics.map((t) => (
            <a href={`/follow/${t.topic.id}`}><span class="name">{t.topic.name}</span><span class="sub">{t.found} system cards, {t.labs.filter((l) => l.found.length).length} labs</span></a>
          ))}
        </div>
      </section>
    )}

    <section class="section split" aria-labelledby="agents-h">
      <div class="agent">
        <h2 class="h2" id="agents-h"><a href="/connect">Connect</a></h2>
        <div class="codeline"><code tabindex="0">{connect}</code><button class="ib" data-copy={connect} aria-label="Copy command"><Icon name="copy" /></button></div>
        <p class="tries"><a href="/connect">search</a><a href="/connect">fetch</a><a href="/connect">verify_quote</a><a href="/connect">check_answer</a></p>
      </div>
      <div class="rooms">
        <a href="/check?example=1">
          <h2 class="h2">Check</h2>
          <Tally citations={[{ state: 'verified' }, { state: 'cited' }, { state: 'rejected' }, { state: 'rejected' }, { state: 'rejected' }]} />
        </a>
        {trace && (
          <a href={`/r/${trace.header.trace_id}`}>
            <h2 class="h2">Replay</h2>
            <span class="sub clamp">{asked!.quoted ? `“${asked!.quoted}”` : asked!.lead}</span>
            <Tally citations={trace.answer?.citations ?? []} />
          </a>
        )}
        <a href="/citationbench">
          <h2 class="h2">CitationBench</h2>
          {runs.length > 0 && <span class="sub">{runs.length} {runs.length === 1 ? 'run' : 'runs'}</span>}
        </a>
      </div>
    </section>
  </div>
</Base>

<script>
  const composer = document.querySelector<HTMLFormElement>('[data-composer]')!;
  composer.addEventListener('input', () => composer.toggleAttribute('data-typed', !!composer.querySelector('input')!.value.trim()));
  const proof = document.querySelector<HTMLElement>('[data-proof]')!;
  proof.querySelectorAll<HTMLElement>('[data-pick]').forEach((claim) =>
    claim.addEventListener('click', () => {
      proof.dataset.show = claim.dataset.pick;
      proof.querySelectorAll('[data-pick]').forEach((c) => c.setAttribute('aria-pressed', String(c === claim)));
    }),
  );
</script>
