---
import Base from '../layouts/Base.astro';
import PageCrop from '../components/PageCrop.astro';
import Tally from '../components/Tally.astro';
import { allRuns, allShelves, featuredTrace, getDoc, getUnit, libraryCounts, otherSnapshot } from '../lib/data';
import { KINDS, anchorLabel, citePath, formatDate, questionParts, shelfName, shelfOrder, shortLabel } from '../lib/cite';
import { EXAMPLE, landingChecks } from '../lib/checks';
import { TOPICS, follow } from '../lib/follow';
import { spanInUnit } from '../lib/quote';
import { mcpUrl } from '../lib/env';

// The example is checked by the server when the site is built: what is printed here is its answer.
const { verified, rejected } = await landingChecks();
const doc = getDoc(EXAMPLE.cite.split('/')[0])!;
const n = libraryCounts();
const num = (x: number) => x.toLocaleString('en');
const where = verified.locations[0];
const unit = getUnit(where.cite)!;
const label = `${shortLabel(doc)} · ${anchorLabel(where.anchor)}`;
const found = spanInUnit(unit, [where.spine_start, where.spine_end])!;
const near = rejected.locations[0];
const nearRange = spanInUnit(unit, [near.spine_start, near.spine_end])!;
const missing = rejected.segments[0].diff.filter((d) => d.op === 'insert').map((d) => d.source);
// The source's wording with the words the quotation dropped marked.
const sourceWords = near.text.replace(/\s+/g, ' ').split(' ');
const trace = featuredTrace();
const asked = trace && questionParts(trace.header.question);
const runs = allRuns();
const mcp = mcpUrl(Astro.site!.origin);
const connect = `claude mcp add --transport http safetypage ${mcp}`;
const shelves = [...allShelves()].sort((a, b) => shelfOrder(a.id) - shelfOrder(b.id) || b.docs.length - a.docs.length);
const topics = await Promise.all(TOPICS.map(follow));
// Search examples are shown only when the library has what they look for.
const examples = n.documents > 1000 ? ['"alignment faking"', 'sabotage evaluation', 'sparse autoencoder*', 'sycophancy NEAR/10 evaluation'] : ['"risk assessment" evaluation', 'sparse autoencoder features', 'risk tolerance'];
// The newest lab documents; on a small library, the newest of anything.
const recent = (shelves.find((s) => s.id === 'labs') ?? shelves[0]).docs.slice(0, 6);
---
<Base>
  <div class="wrap">
    <p class="lede top">A library of the AI safety record: the papers, system cards, safety frameworks and government guidance, searchable to the page. Every citation is checked against the page it names.</p>

    <section class="proof" data-proof data-show="verified" aria-label="A checked citation and a rejected one">
      <div class="claims">
        <p class="rubric">Two quotations of the same page</p>
        <div class="claim" data-claim="verified">
          <p class="prose">Shevlane et al. say model evaluation is “{verified.quote}.”</p>
          <button class="chip" data-state="verified" data-pick="verified" aria-pressed="true"><span class="sr">Verified: </span><span class="chip-label">{label}</span></button>
          <p class="verdict"><span class="state" data-state="verified">On {anchorLabel(where.anchor)}, word for word</span></p>
        </div>
        <div class="claim" data-claim="rejected">
          <p class="prose">A summary that drops one word: “{rejected.quote}.”</p>
          <button class="chip" data-state="rejected" data-pick="rejected" aria-pressed="false"><span class="sr">Rejected: </span><span class="chip-label">{label}</span></button>
          <p class="verdict"><span class="state" data-state="rejected">Not on {anchorLabel(near.anchor)}</span>
            <span class="says">The page says: “{sourceWords.map((w, i) => <>{i > 0 && ' '}{missing.includes(w) ? <ins class="diff">{w}</ins> : w}</>)}”</span>
          </p>
        </div>
        <p class="how">The check is code, not a model: the quoted words must be on the cited page, in order, with nothing skipped. <a class="link" href="/about">How it works</a></p>
      </div>
      <div class="pagepane">
        <div data-pane="verified"><PageCrop unit={unit} ranges={[found]} alt={`${doc.title}, ${anchorLabel(where.anchor)}, with the quoted passage highlighted`} eager /></div>
        <div data-pane="rejected"><PageCrop unit={unit} ranges={[nearRange]} kind="reject" alt={`${doc.title}, ${anchorLabel(near.anchor)}, with the sentence the quotation misquotes outlined`} /></div>
        <p class="caption"><span>{doc.title}, {anchorLabel(where.anchor)} of {doc.unit_count}</span><a class="link" href={citePath(where.cite, verified.quote)}>Open the page</a></p>
      </div>
    </section>

    <section class="search" aria-label="Search">
      <form class="searchbox" action="/search" role="search">
        <input class="field" type="search" name="query" placeholder={`Search ${num(n.documents)} documents to the page`} aria-label="Search the library" />
        <button class="btn btn-primary">Search</button>
      </form>
      <p class="examples"><span>Try</span>{examples.map((q) => <a href={`/search?query=${encodeURIComponent(q)}`}>{q}</a>)}</p>
    </section>

    <dl class="numbers" aria-label="The library in numbers">
      <div><dt>Documents</dt><dd>{num(n.documents)}</dd></div>
      <div><dt>PDF pages</dt><dd>{num(n.pages)}</dd></div>
      <div><dt>Paragraphs of web documents</dt><dd>{num(n.paragraphs)}</dd></div>
      <div><dt>Read in full here</dt><dd>{num(n.open)}</dd></div>
    </dl>

    {topics.some((t) => t.found > 0) && (
      <section class="section" aria-labelledby="follow-h">
        <h2 class="h2" id="follow-h">Follow one evaluation across the labs' system cards</h2>
        <div class="follow">
          {topics.filter((t) => t.found > 0).map((t) => (
            <a href={`/follow/${t.topic.id}`}><span class="name">{t.topic.name}</span><span class="meta">{t.found} cards · {t.labs.filter((l) => l.found.length).length} labs</span></a>
          ))}
        </div>
      </section>
    )}

    <section class="doors" aria-label="What is here">
      {trace && (
        <a class="door" href={`/r/${trace.header.trace_id}`}>
          <h2 class="h2">Watch an agent research</h2>
          <p class="door-main clamp">{asked!.quoted ? `Does the source it cites support this? “${asked!.quoted}”` : asked!.lead}</p>
          <Tally citations={trace.answer?.citations ?? []} />
          {otherSnapshot(trace) && <p class="door-foot">An early run on a six-document test corpus</p>}
        </a>
      )}
      <a class="door" href="/citationbench">
        <h2 class="h2">CitationBench, the benchmark</h2>
        <p class="door-main">Does an agent cite the right page, and quote it accurately?</p>
        <p class="door-foot">{runs.length ? `${runs.length} early ${runs.length === 1 ? 'run' : 'runs'}; every number links to its pages` : 'First runs soon'}</p>
      </a>
      <a class="door" href="/check">
        <h2 class="h2">Check a paragraph</h2>
        <p class="door-main">Paste text with citations. Each one comes back Verified, Page only or Rejected.</p>
        <p class="door-foot">No account</p>
      </a>
      <div class="door">
        <h2 class="h2">Connect your agent</h2>
        <p class="door-main">An MCP server with four tools: search, fetch, verify_quote, check_answer.</p>
        <div class="codeline"><code tabindex="0">{connect}</code><button class="btn btn-quiet" data-copy={connect}>Copy</button></div>
        <a class="link door-foot" href="/connect">Other clients and the JSON API</a>
      </div>
    </section>

    <section class="section shelves-recent">
      <div>
        <h2 class="h2" id="shelves-h">The shelves</h2>
        <ul class="shelflist" aria-labelledby="shelves-h">
          {shelves.map((s) => <li><a href={`/library/${s.id}`}><span>{shelfName(s.id)}</span><span class="mono muted">{num(s.docs.length)}</span></a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="h2" id="recent-h">Newest from the labs</h2>
        <div class="rows" aria-labelledby="recent-h">
          {recent.map((d) => (
            <a href={citePath(d.doc_id)}>
              <span class="meta">{KINDS[d.kind] ?? d.kind} · {formatDate(d.published).replace(/^\d+ /, '')}</span>
              <span><span class="name">{d.title}</span><span class="meta by">{[d.authors.length ? shortLabel(d).replace(/ \d{4}$/, '') : d.org, d.tier === 'open' ? 'Read here' : 'Read at source'].filter(Boolean).join(' · ')}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section colophon" aria-labelledby="made-h">
      <h2 class="h2" id="made-h">How it is made</h2>
      <p class="prose">The text of record is each PDF's own text layer or the web page's own words; no model transcribes a document. A quote check is code, the same code for the reader, the MCP server and the benchmark. Three quarters of the library is not openly licensed: those documents are searched, cited and quote-checked here and read at their source. <a class="link" href="/about">How it works</a> · <a class="link" href="https://github.com/Noah-Airmet/safetypage">Source on GitHub</a> · <a class="link" href="https://github.com/Noah-Airmet/safetypage/blob/main/docs/ARCHITECTURE.md">The design and its decisions</a></p>
    </section>
  </div>
</Base>

<script>
  const proof = document.querySelector<HTMLElement>('[data-proof]')!;
  proof.querySelectorAll<HTMLElement>('[data-pick]').forEach((chip) =>
    chip.addEventListener('click', () => {
      proof.dataset.show = chip.dataset.pick;
      proof.querySelectorAll('[data-pick]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    }),
  );
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!button) return;
    navigator.clipboard.writeText(button.dataset.copy!);
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy'), 1200);
  });
</script>

<style>
  .top { margin-block: var(--s-7) var(--s-6); max-width: 54ch; }
  .proof { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s-7); align-items: start; }
  .claims { display: grid; gap: var(--s-5); }
  .claim { display: grid; gap: var(--s-2); justify-items: start; padding-left: var(--s-4); border-left: 2px solid var(--rule); }
  .proof[data-show='verified'] .claim[data-claim='verified'] { border-color: var(--accent); }
  .proof[data-show='rejected'] .claim[data-claim='rejected'] { border-color: var(--reject); }
  .verdict { display: grid; gap: var(--s-1); font-size: var(--t-13); }
  .says { color: var(--ink-2); font: 400 var(--t-16)/1.45 var(--serif); }
  .how { color: var(--ink-2); font-size: var(--t-13); max-width: 52ch; }
  .proof[data-show='verified'] [data-pane='rejected'], .proof[data-show='rejected'] [data-pane='verified'] { display: none; }
  .caption { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-2); color: var(--ink-2); font-size: var(--t-13); }
  .caption a { white-space: nowrap; }
  @media (max-width: 700px) { .caption { flex-direction: column; gap: var(--s-1); } }
  .search { margin-top: var(--s-7); max-width: 46rem; }
  .doors { margin-top: var(--s-7); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--edge); }
  .door { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-4) var(--s-4) var(--s-4) 0; min-width: 0; }
  .door + .door { padding-left: var(--s-4); border-left: 1px solid var(--rule); }
  .door .h2 { margin: 0 0 var(--s-1); }
  .door-main { font: 400 var(--t-18)/1.35 var(--serif); text-wrap: pretty; }
  .clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
  .door-foot { margin-top: auto; padding-top: var(--s-2); color: var(--ink-2); font-size: var(--t-13); }
  a.door:hover .door-main { color: var(--accent); }
  .door .codeline { margin-top: auto; }
  .door .codeline + .door-foot { margin-top: 0; }
  .by { display: block; margin-top: 2px; }
  .numbers { margin-top: var(--s-6); display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-7); }
  @media (max-width: 700px) { .numbers { display: grid; grid-template-columns: 1fr 1fr; } }
  .numbers div { display: flex; flex-direction: column-reverse; }
  .numbers dt { color: var(--ink-2); font-size: var(--t-13); }
  .numbers dd { font: 400 var(--t-28)/1.15 var(--serif); }
  .follow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--edge); }
  .follow a { display: grid; gap: 2px; padding: var(--s-3) var(--s-3) var(--s-3) 0; border-bottom: 1px solid var(--rule); min-height: 44px; }
  .follow .name { font: 400 var(--t-18)/1.3 var(--serif); }
  .follow .meta { color: var(--ink-2); font-size: var(--t-13); }
  .follow a:hover .name { color: var(--accent); }
  .shelves-recent { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--s-7); align-items: start; }
  .shelflist li { border-top: 1px solid var(--rule); }
  .shelflist li:last-child { border-bottom: 1px solid var(--rule); }
  .shelflist a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); min-height: 44px; padding-block: var(--s-4); font: 400 var(--t-18)/1.3 var(--serif); }
  .shelflist a:hover { color: var(--accent); }
  .shelflist .mono { font-size: var(--t-13); }
  .colophon .prose { font-size: var(--t-16); color: var(--ink-2); max-width: 86ch; }
  @media (max-width: 1000px) {
    .doors { grid-template-columns: 1fr 1fr; }
    .door:nth-child(3) { padding-left: 0; border-left: 0; }
    .door:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }
  @media (max-width: 700px) {
    .top { margin-block: var(--s-5); }
    .proof { grid-template-columns: 1fr; gap: var(--s-4); }
    .claims { display: contents; }
    .pagepane { order: 2; }
    .claim[data-claim='rejected'] { order: 3; }
    .how { order: 4; }
    .search { margin-top: var(--s-6); }
    .doors { grid-template-columns: 1fr; margin-top: var(--s-6); }
    .numbers { gap: var(--s-3) var(--s-5); }
    .follow { grid-template-columns: 1fr 1fr; }
    .numbers dd { font-size: var(--t-22); }
    .shelves-recent { grid-template-columns: 1fr; gap: var(--s-6); }
    .door, .door + .door { padding: var(--s-4) 0; border-left: 0; }
    .door + .door { border-top: 1px solid var(--rule); }
  }
</style>
