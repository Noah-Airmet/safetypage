---
// The library by shelf. Each shelf is its own page; nothing here lists every document.
import Base from '../../layouts/Base.astro';
import { allShelves, libraryCounts } from '../../lib/data';
import { SHELVES, citePath, shelfName, shelfOrder } from '../../lib/cite';
const shelves = [...allShelves()].sort((a, b) => shelfOrder(a.id) - shelfOrder(b.id) || b.docs.length - a.docs.length);
const n = libraryCounts();
const num = (x: number) => x.toLocaleString('en');
---
<Base title="Library" description={`${num(n.documents)} documents on ${shelves.length} shelves, each citable to the page.`}>
  <div class="wrap">
    <header class="pagehead">
      <h1 class="title">Library</h1>
      <p class="muted">{num(n.documents)} documents · {num(n.pages)} pages and {num(n.paragraphs)} paragraphs, each one citable · {num(n.open)} read here, {num(n.documents - n.open)} read at their source{n.snapshot && <> · snapshot <span class="mono">{n.snapshot}</span></>}</p>
      <form class="searchbox find" action="/search" role="search">
        <input class="field" type="search" name="query" placeholder="Search every page" aria-label="Search the library" />
        <button class="btn btn-primary">Search</button>
      </form>
    </header>
    <ul class="shelves">
      {shelves.map((s) => (
        <li>
          <a class="shelf" href={`/library/${s.id}`}>
            <span class="name">{shelfName(s.id)}</span>
            <span class="count mono">{num(s.docs.length)}</span>
          </a>
          {SHELVES[s.id] && <p class="about">{SHELVES[s.id].about}</p>}
          <p class="facets">
            {s.publishers.length > 1 && s.publishers.slice(0, 6).map(([p, c]) => <a href={`/library/${s.id}?publisher=${encodeURIComponent(p)}`}>{p} <span class="mono">{num(c)}</span></a>)}
            {s.publishers.length > 6 && <a href={`/library/${s.id}`}>{s.publishers.length - 6} more</a>}
          </p>
          <p class="newest"><span class="muted">Newest:</span> <a href={citePath(s.docs[0].doc_id)}>{s.docs[0].title}</a></p>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .find { max-width: 40rem; margin-top: var(--s-2); }
  .shelves > li { padding-block: var(--s-4); border-top: 1px solid var(--rule); display: grid; gap: var(--s-1); }
  .shelves > li:last-child { border-bottom: 1px solid var(--rule); }
  .shelf { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); min-height: 44px; }
  .shelf .name { font: 400 var(--t-28)/1.2 var(--serif); }
  .shelf:hover .name { color: var(--accent); }
  .shelf .count { color: var(--ink-2); font-size: var(--t-16); }
  .about { color: var(--ink-2); max-width: 72ch; }
  .facets { display: flex; flex-wrap: wrap; gap: 0 var(--s-4); font-size: var(--t-13); }
  .facets:empty { display: none; }
  .facets a { display: inline-flex; align-items: center; gap: var(--s-1); min-height: 28px; }
  .facets a:hover { color: var(--accent); }
  .facets .mono { color: var(--ink-3); font-size: var(--t-12); }
  .newest { font-size: var(--t-13); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .newest a:hover { color: var(--accent); }
  @media (max-width: 700px) { .shelf .name { font-size: var(--t-22); } }
</style>
