---
// /q/<id>: one quote check with its page, and a preview card that says the verdict.
import Base from '../../layouts/Base.astro';
import PageCrop from '../../components/PageCrop.astro';
import { allChecks, type StoredCheck } from '../../lib/checks';
import { getDoc, getUnit } from '../../lib/data';
import { anchorLabel, anchorOf, citePath, docIdOf, shortLabel } from '../../lib/cite';
import { spanInUnit } from '../../lib/quote';

export const getStaticPaths = async () => (await allChecks()).map((check) => ({ params: { id: check.id }, props: { check } }));
const { check } = Astro.props as { check: StoredCheck };
const doc = getDoc(docIdOf(check.cite))!;
const here = anchorLabel(anchorOf(check.cite));
const shownAt = anchorLabel(anchorOf(check.shown));
const unit = getUnit(check.shown);   // open documents only: a link-only page has no published text
const range = unit && check.span ? spanInUnit(unit, check.span) : null;
const verdicts: Record<string, string> = {
  exact: `On ${here}, word for word`, normalized: `On ${here}, ignoring case and punctuation`,
  elsewhere: `Not on ${here}; on ${shownAt}`, near_miss: `Not on ${here}`, not_found: `Not in this document`,
};
const said = unit?.text && range ? unit.text.slice(range[0], range[1]).replace(/\s+/g, ' ') : null;
---
<Base title={`${check.passed ? 'Verified' : 'Rejected'}: “${check.quote.slice(0, 60)}”`} description={`${verdicts[check.verdict]}. ${doc.title}.`} og={`/og/q/${check.id}.png`}>
  <div class="wrap qpage">
    <div class="qpage-say">
      <nav class="up" aria-label="Up"><a href={citePath(doc.doc_id)}>{shortLabel(doc)}</a></nav>
      <h1 class="quote">“{check.quote}”</h1>
      <p><span class="state" data-state={check.passed ? 'verified' : 'rejected'}>{verdicts[check.verdict]}</span></p>
      {!check.passed && said && <p class="says">{shownAt}: “{said}”</p>}
      <p class="actions">
        <a class="btn btn-primary" href={citePath(check.shown, check.passed ? check.quote : undefined)}>Open {shownAt}</a>
        <a class="btn" href={`/check?text=${encodeURIComponent(`"${check.quote}" (${check.cite})`)}`}>Check again</a>
      </p>
    </div>
    {unit?.width && range && <PageCrop unit={unit} ranges={[range]} kind={check.passed ? 'found' : 'reject'} alt={`${doc.title}, ${shownAt}`} eager />}
  </div>
</Base>
