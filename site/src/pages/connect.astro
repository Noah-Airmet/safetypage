---
import Base from '../layouts/Base.astro';
import { MCP_URL } from '../lib/env';
const site = Astro.site!.origin;
const mcp = MCP_URL || `${site}/mcp`;
const clients = [
  ['Claude Code', `claude mcp add --transport http onthepage ${mcp}`],
  ['Claude.ai, ChatGPT and other clients: add a connector with this URL', mcp],
];
const tools = [
  ['search', 'search(query, collection?, org?, kind?, date_from?, date_to?, doc?, mode?, sort?, limit?)', 'Ranked pages and paragraphs. Words are ANDed; "a phrase", prefix*, a NEAR/5 b and -exclude work. Every hit is a citation.'],
  ['fetch', 'fetch(id)', 'A document id returns its record and outline. A cite string returns the page or paragraph: the full text if the licence allows, otherwise its opening words and a link that opens the source at that page.'],
  ['verify_quote', 'verify_quote(quote, cite?, doc?)', 'Whether the words are at the cited place. Five verdicts: exact and normalized pass; elsewhere, near_miss and not_found fail, with where the words really are or what the page says instead.'],
  ['check_answer', 'check_answer(text)', 'Audits a draft answer: every citation in it, the quotations attached to each, and how each one checked out.'],
];
const api = [
  ['GET', '/api/search?query=…', 'SearchResponse'],
  ['GET', '/api/doc/<ns>/<id>[/<version>]', 'DocumentCard'],
  ['GET', '/api/units/<ns>/<id>/<version>/<anchor>', 'UnitText[]'],
  ['POST', '/api/verify', 'QuoteCheck'],
  ['POST', '/api/check', 'AnswerAudit'],
];
---
<Base title="Connect" description="Connect an agent to the library over MCP: search, fetch, verify_quote, check_answer.">
  <div class="wrap narrow">
    <header class="pagehead">
      <h1 class="title">Connect your agent</h1>
      <p class="lede">An MCP server with four read-only tools. No key, no account.</p>
    </header>

    <section>
      <h2 class="h2">Add the server</h2>
      <dl class="clients">
        {clients.map(([name, line]) => (
          <>
            <dt>{name}</dt>
            <dd><div class="codeline"><code tabindex="0">{line}</code><button class="btn btn-quiet" data-copy={line}>Copy</button></div></dd>
          </>
        ))}
      </dl>
    </section>

    <section class="section">
      <h2 class="h2">The tools</h2>
      <ul class="tools">
        {tools.map(([name, sig, what]) => (
          <li><h3 class="mono">{sig}</h3><p>{what}</p></li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2 class="h2">What a citation looks like</h2>
      <pre class="code">{`arxiv:2305.15324/v2/p6                         document / version / place
${site}/d/arxiv/2305.15324/v2/p6     the same thing, as a link
…/v2/p6?q=not%20the%20only%20tool                 with the quoted words highlighted`}</pre>
      <p class="after muted">A citation always names a version, because pages move when a paper is revised. <span class="mono">p6</span> is a PDF page; <span class="mono">b12</span> is a paragraph of a document that has no pages.</p>
    </section>

    <section class="section">
      <h2 class="h2">The same functions over HTTP</h2>
      <div class="scroll"><table class="table">
        <thead><tr><th>Method</th><th>Route</th><th>Returns</th></tr></thead>
        <tbody>{api.map(([m, route, model]) => <tr><td class="mono">{m}</td><td class="mono">{route}</td><td class="mono">{model}</td></tr>)}</tbody>
      </table></div>
      <p class="after muted">JSON Schemas for every model are in <a class="link" href="https://github.com/Noah-Airmet/onthepage/tree/main/schemas">schemas/</a>. The design is in <a class="link" href="https://github.com/Noah-Airmet/onthepage/blob/main/docs/ARCHITECTURE.md">docs/ARCHITECTURE.md</a>.</p>
    </section>
  </div>
</Base>
<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!button) return;
    navigator.clipboard.writeText(button.dataset.copy!);
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy'), 1200);
  });
</script>
<style>
  .narrow { max-width: 52rem; }
  .scroll td { white-space: nowrap; }
  .clients { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--s-2) var(--s-4); align-items: center; }
  .clients dt { color: var(--ink-2); }
  .tools li { padding-block: var(--s-3); border-top: 1px solid var(--rule); display: grid; gap: var(--s-1); }
  .tools li:last-child { border-bottom: 1px solid var(--rule); }
  .tools h3 { font-weight: 500; font-size: var(--t-13); overflow-wrap: anywhere; }
  .tools p { color: var(--ink-2); max-width: 70ch; }
  .after { margin-top: var(--s-3); max-width: 70ch; }
  @media (max-width: 700px) { .clients { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); } .clients dd { margin-bottom: var(--s-3); } }
</style>
