---
// How a run's citations came out: 2 verified, 1 page only, 2 rejected.
interface Props { citations: { state: string }[] }
const count = (s: string) => Astro.props.citations.filter((c) => c.state === s).length;
---
<span class="tally">
  <span class="state" data-state="verified">{count('verified')} verified</span>
  <span class="state" data-state="cited">{count('cited')} page only</span>
  <span class="state" data-state="rejected">{count('rejected')} rejected</span>
</span>
