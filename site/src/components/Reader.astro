---
// The reader, opened at an anchor. Three forms: page images with a text layer (open PDFs),
// the text re-set in our template (open HTML documents), and the source card (link-only).
import type { DocumentCard, UnitText } from '../lib/types';
import { anchorLabel, anchorNumber, citePath, licenceName, shortLabel, sourceLink } from '../lib/cite';
import { DATA_BASE, pageImageUrl } from '../lib/env';

interface Props { doc: DocumentCard; version: string; anchor: string; units: UnitText[] }
const { doc, version, anchor, units } = Astro.props;
const ref = `${doc.doc_id}/${version}`;
const summary = doc.versions.find((v) => v.version === version)!;
const open = summary.tier === 'open' && units.length > 0;
const paged = anchor.startsWith('p');
const count = units.length || doc.unit_count;
const n = anchorNumber(anchor);
const host = new URL(doc.source_url).hostname.replace(/^www\./, '');
const latest = version === doc.version;
const outline = latest ? doc.outline : [];
const meta = { doc_id: doc.doc_id, title: doc.title, authors: doc.authors, org: doc.org, published: doc.published, short: shortLabel(doc) };
const tags: Record<string, string> = { quote: 'blockquote', code: 'pre' };
---
<div class="reader" data-reader data-mode={!open ? 'source' : paged ? 'pages' : 'text'} data-ref={ref} data-target={anchor} data-count={count} data-doc={JSON.stringify(meta)} data-base={DATA_BASE}>
  <div class="rbar">
    <div class="wrap rbar-in">
      <a class="rback" href={citePath(ref)} aria-label={`Record: ${doc.title}`}><span aria-hidden="true">‹</span><span class="rtitle">{doc.title}</span></a>
      {paged && open ? (
        <form class="goto" data-goto>
          <label><span class="sr">Go to page</span><span aria-hidden="true">p.</span>
            <input class="field mono" name="page" inputmode="numeric" autocomplete="off" value={n} aria-label="Page number" />
          </label>
          <span class="muted mono">/ {count}</span>
        </form>
      ) : <span class="muted mono" data-here>{anchorLabel(anchor)}</span>}
      {outline.length > 0 && (
        <details class="contents">
          <summary class="btn btn-quiet">Contents</summary>
          <ol>
            {outline.map((item) => (
              <li style={`--level:${item.level - 1}`}><a href={citePath(item.cite)} data-jump={item.anchor}><span>{item.title}</span><span class="mono muted">{anchorLabel(item.anchor)}</span></a></li>
            ))}
          </ol>
        </details>
      )}
      <a class="btn btn-quiet rsource" href={sourceLink(doc.source_url, anchor, paged)} rel="noopener" data-source>Source ↗</a>
    </div>
    <p class="wrap qstatus" data-qstatus hidden></p>
  </div>

  {open && paged && (
    <div class="desk">
      {units.map((unit) => {
        const eager = Math.abs(anchorNumber(unit.anchor) - n) <= 1;
        return (
          <figure class="sheet" id={unit.anchor} data-unit={unit.anchor} style={`aspect-ratio:${unit.width ?? 612}/${unit.height ?? 792}`}>
            <img src={pageImageUrl(unit.cite, 800)} srcset={`${pageImageUrl(unit.cite, 800)} 800w, ${pageImageUrl(unit.cite, 1600)} 1600w`} sizes="(max-width: 900px) 100vw, 860px"
              width={Math.round(unit.width ?? 612)} height={Math.round(unit.height ?? 792)} alt={`${doc.title}, ${unit.anchor_label}`} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={unit.anchor === anchor ? 'high' : undefined} />
            <div class="textlayer" data-textlayer></div>
          </figure>
        );
      })}
    </div>
  )}

  {open && !paged && (
    <article class="wrap textdoc">
      <header>
        <p class="rubric">{[doc.org, licenceName(summary.licence)].filter(Boolean).join(' · ')}</p>
        <h1 class="title">{doc.title}</h1>
        <p class="muted">{doc.authors.join(', ')}</p>
      </header>
      {units.map((unit) => {
        const kind = unit.kind ?? 'paragraph';
        const Tag = (kind === 'heading' ? `h${Math.min(4, (unit.level ?? 1) + 1)}` : tags[kind] ?? 'p') as 'p';
        return (
          <div class="block" id={unit.anchor} data-unit={unit.anchor} data-kind={kind}>
            <a class="gutter mono" href={citePath(unit.cite)} aria-label={`Link to paragraph ${anchorNumber(unit.anchor)}`}>¶{anchorNumber(unit.anchor)}</a>
            <Tag class="t">{unit.text}</Tag>
          </div>
        );
      })}
    </article>
  )}

  {!open && (
    <div class="desk">
      <section class="sourcecard" data-unit={anchor}>
        <p class="mono muted">{anchorLabel(anchor)} of {count}</p>
        <h1>{doc.title}</h1>
        <p class="why">The library holds this document for search and for checking quotes. Its licence does not let us show the {paged ? 'page' : 'text'} here, so it opens at its source.</p>
        <a class="btn btn-primary" href={sourceLink(doc.source_url, anchor, paged)} rel="noopener">Open {paged ? anchorLabel(anchor) : 'it'} at {host} ↗</a>
        <p class="links">
          <button class="link" data-copy={`${ref}/${anchor}`}>Copy citation</button>
          <a class="link" href={`/check?text=${encodeURIComponent(`"" (${ref}/${anchor})`)}`}>Check a quote on this {paged ? 'page' : 'paragraph'}</a>
          <a class="link" href={`/search?doc=${encodeURIComponent(doc.doc_id)}`}>Search inside it</a>
        </p>
        <nav class="pager" aria-label="Pages">
          {n > 1 ? <a class="btn" href={citePath(`${ref}/${anchor[0]}${n - 1}`)}>‹ {anchorLabel(`${anchor[0]}${n - 1}`)}</a> : <span></span>}
          {n < count ? <a class="btn" href={citePath(`${ref}/${anchor[0]}${n + 1}`)}>{anchorLabel(`${anchor[0]}${n + 1}`)} ›</a> : <span></span>}
        </nav>
        <p class="mono muted foot-line">{licenceName(summary.licence)} · Read at source</p>
      </section>
    </div>
  )}

  <div class="selpop" data-selpop hidden role="toolbar" aria-label="Selection">
    <button data-act="quote">Copy quote</button><button data-act="link">Copy link</button><button data-act="check">Check</button>
  </div>
</div>

<script>
  import '../scripts/reader.ts';
</script>

<style is:global>
  .rbar { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--rule); }
  .rbar-in { display: flex; align-items: center; gap: var(--s-3); min-height: var(--bar); }
  .rback { display: flex; align-items: center; gap: var(--s-2); min-width: 0; flex: 1; min-height: 44px; }
  .rback:hover { color: var(--accent); }
  .rtitle { font: 500 var(--t-16)/1.2 var(--serif); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .goto { display: flex; align-items: center; gap: var(--s-2); flex: none; }
  .goto label { display: flex; align-items: center; gap: var(--s-2); color: var(--ink-2); font-family: var(--mono); font-size: var(--t-13); }
  .goto .field { width: 3.4rem; text-align: center; padding-inline: var(--s-1); font-size: var(--t-13); }
  .goto .muted { font-size: var(--t-13); }
  .contents { position: relative; flex: none; }
  .contents summary { list-style: none; }
  .contents summary::-webkit-details-marker { display: none; }
  .contents ol { position: absolute; right: 0; top: calc(100% + var(--s-1)); width: min(26rem, calc(100vw - 2 * var(--s-4))); max-height: 70vh; overflow: auto; background: var(--surface); border: 1px solid var(--edge); border-radius: var(--r-2); box-shadow: var(--shadow); padding: var(--s-2); }
  .contents li a { display: flex; justify-content: space-between; gap: var(--s-3); padding: var(--s-2); border-radius: var(--r-1); min-height: 36px; align-items: baseline; }
  .contents li a:hover { background: var(--wash); }
  .contents li:not([style*='level:0']) a > span:first-child { color: var(--ink-2); }
  .contents .mono { font-size: var(--t-12); white-space: nowrap; }
  .rsource { flex: none; }
  .qstatus { padding-block: var(--s-2); border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); align-items: baseline; }
  .qstatus[hidden] { display: none; }
  .qstatus q { font-family: var(--serif); font-size: var(--t-16); quotes: '“' '”'; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  @media (max-width: 700px) { .rsource { display: none; } .contents summary { padding-inline: var(--s-1); } }

  .desk { background: var(--desk); padding: var(--s-5) var(--s-4) var(--s-8); display: grid; gap: var(--s-4); justify-items: center; }
  .desk .sheet { width: min(100%, 860px); scroll-margin-top: calc(var(--bar) + var(--s-4)); }
  @media (max-width: 700px) { .desk { padding: var(--s-2) 0 var(--s-7); gap: var(--s-2); } }

  .textdoc { max-width: calc(var(--measure) + 8rem); padding-block: var(--s-7); }
  .textdoc header { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); padding-left: 4rem; }
  .block { position: relative; padding-left: 4rem; scroll-margin-top: calc(var(--bar) + var(--s-5)); }
  .block .t { font: 400 var(--t-18)/1.6 var(--serif); margin: 0 0 0.9em; max-width: var(--measure); white-space: pre-line; }
  .block h2.t { font: 600 var(--t-28)/1.2 var(--serif); margin: 1.6em 0 0.5em; }
  .block h3.t { font: 600 var(--t-22)/1.25 var(--serif); margin: 1.4em 0 0.4em; }
  .block h4.t { font: 600 var(--t-18)/1.3 var(--serif); margin: 1.2em 0 0.3em; }
  .block[data-kind='caption'] .t, .block[data-kind='footnote'] .t, .block[data-kind='reference'] .t { font: 400 var(--t-14)/1.5 var(--sans); color: var(--ink-2); }
  .block[data-kind='list_item'] .t { display: list-item; list-style: disc; margin-left: 1.2em; }
  .block[data-kind='quote'] .t { border-left: 2px solid var(--edge); padding-left: var(--s-4); }
  .block[data-kind='code'] .t, .block[data-kind='table'] .t, .block[data-kind='equation'] .t { font: 400 var(--t-13)/1.55 var(--mono); white-space: pre-wrap; }
  .block[data-kind='figure'] .t { font: 400 var(--t-14)/1.5 var(--sans); color: var(--ink-2); border: 1px dashed var(--edge); border-radius: var(--r-1); padding: var(--s-3); }
  .gutter { position: absolute; left: 0; top: 0.45em; width: 3.2rem; text-align: right; font-size: var(--t-12); color: var(--ink-3); opacity: 0; transition: opacity 120ms; }
  .block h2 ~ .gutter, .block:has(h2) .gutter { top: 3.4em; }
  .block:hover .gutter, .gutter:focus-visible, .block[data-target] .gutter { opacity: 1; }
  .gutter:hover { color: var(--accent); }
  .block[data-target] .t { background: var(--wash); box-shadow: -8px 0 0 var(--wash), 8px 0 0 var(--wash); }
  @media (max-width: 700px) {
    .textdoc header, .block { padding-left: 0; }
    .block .t { font-size: 1.0625rem; }
    .gutter { display: none; }
  }

  .sourcecard { width: min(100%, 620px); aspect-ratio: 612 / 792; background: var(--surface); box-shadow: 0 0 0 1px var(--edge); padding: clamp(var(--s-5), 8%, var(--s-8)); display: flex; flex-direction: column; gap: var(--s-4); align-items: flex-start; }
  .sourcecard h1 { font: 400 var(--t-28)/1.2 var(--serif); text-wrap: balance; }
  .sourcecard .why { font: 400 var(--t-16)/1.55 var(--serif); color: var(--ink-2); max-width: 44ch; }
  .sourcecard .links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: center; }
  .sourcecard .links > * { min-height: 24px; display: inline-flex; align-items: center; font-size: var(--t-14); }
  .sourcecard .pager { display: flex; justify-content: space-between; width: 100%; margin-top: auto; }
  .sourcecard .foot-line { font-size: var(--t-12); }
  @media (max-width: 700px) { .sourcecard { aspect-ratio: auto; min-height: 70vh; } .sourcecard .links { flex-direction: column; align-items: flex-start; } }

  .selpop { position: fixed; z-index: 10; display: flex; background: var(--ink); color: var(--bg); border-radius: var(--r-1); box-shadow: var(--shadow); overflow: hidden; transform: translate(-50%, -100%); }
  .selpop[hidden] { display: none; }
  .selpop button { height: 36px; padding-inline: var(--s-3); font: 500 var(--t-13)/1 var(--sans); }
  .selpop button + button { border-left: 1px solid color-mix(in srgb, var(--bg) 25%, transparent); }
  .selpop button:hover { background: color-mix(in srgb, var(--bg) 14%, transparent); }
</style>
