---
// A window onto one page, centred on a passage, with the passage lit. Built from the page's
// word boxes, so what is lit here is what the checker matched.
import type { UnitText } from '../lib/types';
import { highlightRects } from '../lib/quote';
import { pageImageUrl } from '../lib/env';

interface Props { unit: UnitText; ranges: [number, number][]; kind?: 'found' | 'reject'; alt: string; eager?: boolean }
const { unit, ranges, kind = 'found', alt, eager } = Astro.props;
const rects = ranges.flatMap(([s, e]) => highlightRects(unit, s, e));
const top = rects.length ? Math.min(...rects.map((r) => r.top)) : 10;
const shift = Math.max(0, top - 11);
---
<div class="crop">
  <div class="sheet" style={`aspect-ratio:${unit.width}/${unit.height};transform:translateY(-${shift.toFixed(2)}%)`}>
    <img src={pageImageUrl(unit.cite, 1600)} width={Math.round(unit.width!)} height={Math.round(unit.height!)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    {rects.map((r) => <div class="hl" data-kind={kind === 'reject' ? 'reject' : undefined} style={`left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`} />)}
  </div>
</div>
<style>
  .crop { position: relative; overflow: hidden; aspect-ratio: 5 / 4; background: #fff; box-shadow: 0 0 0 1px var(--edge); border-radius: var(--r-1); }
  .crop .sheet { position: absolute; left: -11%; top: 0; width: 122%; box-shadow: none; overflow: visible; }
  @media (max-width: 700px) { .crop { aspect-ratio: 4 / 3; } .crop .sheet { left: -13%; width: 126%; } }
</style>
