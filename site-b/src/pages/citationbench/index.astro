---
// The leaderboard, read from CitationBench's results files (one per run). Every number links to
// the run it came from, every run lists its questions, and every question opens its replay.
import Base from '../../layouts/Base.astro';
import { allRuns } from '../../lib/data';
import type { Estimate, RunResult } from '../../lib/types';

const runs = allRuns();
const COLUMNS = [
  { key: 'correct', label: 'Correct', source: 'code' },
  { key: 'page_precision', label: 'Page precision', source: 'code' },
  { key: 'quote_fidelity', label: 'Quote fidelity', source: 'code' },
  { key: 'support_rate', label: 'Claim support', source: 'judge' },
];
const pct = (x: number | null | undefined) => (x == null ? '–' : String(Math.round(x * 100)));
// No interval is printed when the bootstrap gave none (a handful of questions from one or two documents).
const half = (e: Estimate) => (e.ci_low == null || e.ci_high == null || e.ci_high === e.ci_low ? null : Math.round(((e.ci_high - e.ci_low) / 2) * 100));
// A rank band from the intervals on Correct: a run shares a band with every run it overlaps.
const band = (run: RunResult) => {
  const me = run.measures.correct;
  const better = runs.filter((r) => (r.measures.correct.ci_low ?? 0) > (me.ci_high ?? 0)).length;
  const notWorse = runs.filter((r) => (r.measures.correct.ci_high ?? 0) >= (me.ci_low ?? 0)).length;
  return better + 1 === notWorse ? `${notWorse}` : `${better + 1}–${notWorse}`;
};
const judges = [...new Map(runs.filter((r) => r.judge).map((r) => [r.judge!.id, r.judge!])).values()];
const updated = runs.map((r) => r.created_at.slice(0, 10)).sort().at(-1);
const small = runs.some((r) => r.samples < 50);
---
<Base title="CitationBench" description="A benchmark of page-level citation: does an agent cite the right page, quote it accurately, and make claims the page supports?">
  <div class="wrap">
    <header class="head">
      <h1 class="title">CitationBench</h1>
      <p class="byline">Does an agent cite the right page, quote it accurately, and make claims the page supports?</p>
      {runs.length > 0 && <p class="facts"><span>{runs.length} {runs.length === 1 ? 'run' : 'runs'}</span><span>Updated {updated}</span>{small && <span>Early runs, too small to compare models</span>}</p>}
    </header>

    {runs.length === 0 ? <p class="muted">No runs yet</p> : (
      <div class="scroll" tabindex="0" role="region" aria-label="Results">
        <table class="table board">
          <thead>
            <tr>
              <th>Rank</th><th>Agent</th>
              {COLUMNS.map((c) => <th class="num">{c.label}<span class="src">{c.source}</span></th>)}
              <th class="whisk"><span class="sr">Correct, with its 95% interval</span></th>
              <th class="num">$ per correct<span class="src">answer</span></th>
              <th class="num">Questions</th>
            </tr>
          </thead>
          <tbody>
            {runs.map((run) => {
              const href = `/citationbench/runs/${run.run_id}`;
              const c = run.measures.correct;
              const cost = run.cost.per_correct_usd.mean;
              return (
                <tr>
                  <td>{band(run)}</td>
                  <td><a href={href}><span class="model">{run.model.split('/').pop()}</span><span class="solver mono">{run.solver} {run.name} {run.snapshot}</span></a></td>
                  {COLUMNS.map((col) => {
                    const e = run.measures[col.key];
                    return <td class="num"><a href={href} title={e?.mean == null ? 'not measured' : `${pct(e.ci_low)} to ${pct(e.ci_high)}, n = ${e.n}`}>{pct(e?.mean)}{e && half(e) != null && <span class="pm"> ±{half(e)}</span>}</a></td>;
                  })}
                  <td class="whisk">
                    {c.mean != null && <span class="whisker"><i class="ci" style={`left:${(c.ci_low ?? c.mean) * 100}%;width:${((c.ci_high ?? c.mean) - (c.ci_low ?? c.mean)) * 100}%`}></i><i class="dot" style={`left:${c.mean * 100}%`}></i></span>}
                  </td>
                  <td class="num"><a href={href}>{cost == null || !run.cost.priced ? '–' : cost < 0.1 ? `$${cost.toFixed(3)}` : `$${cost.toFixed(2)}`}</a></td>
                  <td class="num"><a class="link" href={href}>{run.samples}</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    <dl class="terms section">
      <dt>Correct</dt><dd>The verdict is right, a cited page is a gold page, and code rejects no citation.</dd>
      <dt>Code</dt><dd>Deterministic: the cited page exists, the run opened it, and the quoted words are on it.</dd>
      <dt>Judge</dt><dd>{judges.length > 0
        ? <>A model's verdict: {judges.map((j, i) => <>{i > 0 && ', '}<span class="mono">{j.id}</span></>)}. {judges.some((j) => j.agreement) ? 'Its agreement with human labels is published with each run.' : 'Its agreement with human labels is not measured yet.'}</>
        : "A model's verdict, named with its agreement with human labels."}</dd>
      <dt>Rank</dt><dd>A band: runs whose 95% intervals on Correct overlap share one. Bootstrap over questions, clustered by document.</dd>
      <dt>Percent</dt><dd>Higher is better; ± is half the 95% interval.</dd>
      <dt>Method</dt><dd><a class="link" href="https://github.com/Noah-Airmet/safetypage/tree/main/citationbench">citationbench/ on GitHub</a></dd>
    </dl>
  </div>
</Base>
