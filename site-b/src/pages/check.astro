---
import Base from '../layouts/Base.astro';
import Checker from '../islands/Checker.tsx';
---
<Base title="Check a paragraph" description="Paste text with citations and see each one marked Verified, Page only or Rejected, with the reason.">
  <div class="wrap">
    <header class="head">
      <h1 class="title">Check a paragraph</h1>
      <p class="tally"><span class="state" data-state="verified">Verified</span><span class="state" data-state="cited">Page only</span><span class="state" data-state="rejected">Rejected</span></p>
    </header>
    <Checker client:load />
  </div>
</Base>
