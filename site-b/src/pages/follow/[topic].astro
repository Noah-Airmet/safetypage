---
// /follow/<topic>: one evaluation or topic across the labs' system and model cards. A saved
// search, laid out by lab and date; every row is a citation.
import Base from '../../layouts/Base.astro';
import { TOPICS, follow, sectionOf, type Followed } from '../../lib/follow';
import { anchorLabel, citePath, formatDate } from '../../lib/cite';
import type { Hit } from '../../lib/types';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  return Promise.all(TOPICS.map(async (topic) => ({ params: { topic: topic.id }, props: { data: await follow(topic) } })));
}
const { data } = Astro.props as { data: Followed };
const { topic, labs } = data;
const query = topic.queries[0];
const y0 = Number(data.from), y1 = Number(data.to) + 1;
// Where a date falls on the strip, as a percentage of its width.
const at = (published: string) => {
  const [y, m = 7, d = 1] = published.split('-').map(Number);
  return (((y + (m - 1) / 12 + (d - 1) / 365 - y0) / (y1 - y0)) * 100).toFixed(2);
};
const years = Array.from({ length: y1 - y0 }, (_, i) => y0 + i);
const parts = (hit: Hit) => {
  const out: (string | { mark: string })[] = [];
  let i = 0;
  for (const [s, e] of hit.match_spans) {
    if (s < i) continue;
    out.push(hit.snippet.slice(i, s), { mark: hit.snippet.slice(s, e) });
    i = e;
  }
  out.push(hit.snippet.slice(i));
  return out;
};
const shown = labs.filter((l) => l.found.length > 0);
---
<Base title={`${topic.name} across the labs' system cards`} description={`${data.found} of ${data.cards} system and model cards mention it. Each mention opens the page.`}>
  <div class="wrap">
    <header class="head">
      <nav class="up" aria-label="Up"><a href="/follow">Follow</a></nav>
      <h1 class="title">{topic.name}</h1>
      <p class="byline">{topic.about}</p>
      <p class="facts"><span>{data.found} of {data.cards} cards</span><a class="link mono" href={`/search?query=${encodeURIComponent(query)}&kind=system_card`}>{topic.queries.join(' or ')}</a></p>
      <nav class="switch" aria-label="Topics">
        {TOPICS.map((t) => <a href={`/follow/${t.id}`} aria-current={t.id === topic.id ? 'page' : undefined}>{t.name}</a>)}
      </nav>
    </header>

    {data.from && (
      <div class="strip" role="img" aria-label={`Each lab's cards by date from ${data.from} to ${data.to}. A filled mark is a card that mentions ${topic.name.toLowerCase()}: ${shown.map((l) => `${l.org}, ${l.found.length} of ${l.found.length + l.silent.length}`).join('; ')}.`}>
        {labs.map((lab) => (
          <div class="lane">
            <span class="lab">{lab.org}</span>
            <span class="track">
              {lab.silent.filter((d) => d.published).map((d) => <i style={`left:${at(d.published!)}%`} />)}
              {lab.found.filter((f) => f.doc.published).map((f) => <i data-found style={`left:${at(f.doc.published!)}%`} />)}
            </span>
          </div>
        ))}
        <div class="axis"><span class="track">{years.map((y) => <span style={`left:${at(String(y) + '-01')}%`}>{y}</span>)}</span></div>
        <p class="key"><i data-found /> Mentions it <i /> Does not</p>
      </div>
    )}

    {shown.length === 0 && <p class="muted">No card mentions it</p>}
    {labs.map((lab) => (
      <section class="lab-section" aria-labelledby={`lab-${lab.org.replace(/\W+/g, '-')}`}>
        <h2 class="h2" id={`lab-${lab.org.replace(/\W+/g, '-')}`}><span class="org">{lab.org}</span><span class="muted">{lab.found.length} of {lab.found.length + lab.silent.length} cards</span></h2>
        <ol class="cards">
          {lab.found.map(({ doc, hits, count }) => (
            <li>
              <span class="when">{formatDate(doc.published).replace(/^\d+ /, '') || 'Undated'}</span>
              <div class="card-body">
                <a class="name" href={citePath(doc.doc_id)}>{doc.title}</a>
                {hits.map((hit) => (
                  <a class="hit" href={citePath(hit.cite)}>
                    <span class="hit-head"><span class="pg">{anchorLabel(hit.anchor)}</span>{(hit.anchor[0] === 'p' ? sectionOf(doc, hit) : hit.anchor_label.replace(/\s*¶\d+$/, '')) && <span class="sect">{hit.anchor[0] === 'p' ? sectionOf(doc, hit) : hit.anchor_label.replace(/\s*¶\d+$/, '')}</span>}</span>
                    <span class="snippet">{parts(hit).map((p) => (typeof p === 'string' ? p : <mark>{p.mark}</mark>))}</span>
                  </a>
                ))}
                {count > hits.length && <a class="btn btn-quiet rest" href={`/search?query=${encodeURIComponent(query)}&doc=${encodeURIComponent(doc.doc_id)}`}>All {count} {doc.anchor_kind === 'page' ? 'pages' : 'paragraphs'}</a>}
              </div>
            </li>
          ))}
        </ol>
        {lab.silent.length > 0 && (
          <details class="more silent">
            <summary>{lab.silent.length} without it<Icon name="down" small /></summary>
            <ul>{lab.silent.map((d) => <li><a href={citePath(d.doc_id)}>{d.title}</a> <span class="muted">{formatDate(d.published).replace(/^\d+ /, '')}</span></li>)}</ul>
          </details>
        )}
      </section>
    ))}
  </div>
</Base>
