---
// One shelf. The newest documents are printed here; the filters and More read the shelf's
// catalogue file (/catalogue/<shelf>.json), fetched the first time one is used.
import Base from '../../layouts/Base.astro';
import I from '../../components/I.astro';
import { allShelves, type Shelf } from '../../lib/data';
import { KINDS, SHELVES, clothOf, shelfName } from '../../lib/cite';
import { rowHtml, toRow } from '../../lib/catalogue';

export const getStaticPaths = () => allShelves().map((shelf) => ({ params: { shelf: shelf.id }, props: { shelf } }));
const { shelf } = Astro.props as { shelf: Shelf };
const FIRST = 60;
const total = shelf.docs.length;
const num = (x: number) => x.toLocaleString('en');
const open = shelf.docs.filter((d) => d.tier === 'open').length;
const cloth = clothOf(shelf.id);
// Each filter is one button naming its choice, opening a menu of the choices with their counts.
const picks: { name: string; label: string; options: [string, string, number][] }[] = [
  { name: 'publisher', label: 'Publisher', options: shelf.publishers.length > 1 ? shelf.publishers.map(([p, c]) => [p, p, c]) : [] },
  { name: 'kind', label: 'Kind', options: shelf.kinds.length > 1 ? shelf.kinds.map(([k, c]) => [k, KINDS[k] ?? k, c]) : [] },
  { name: 'year', label: 'Year', options: shelf.years.length > 1 ? shelf.years.map(([y, c]) => [y, y, c]) : [] },
  { name: 'read', label: 'Read', options: open > 0 && open < total ? [['here', 'Read here', open], ['source', 'Read at source', total - open]] : [] },
].filter((p) => p.options.length) as never;
---
<Base title={shelfName(shelf.id)} name={shelfName(shelf.id)} description={`${num(total)} documents. ${SHELVES[shelf.id]?.about ?? ''}`}>
  <div class="page">
    <header class="head">
      <nav class="crumbs" aria-label="Up"><a href="/library">Library</a><I name="forward" /></nav>
      <h1>{shelfName(shelf.id)}</h1>
      <p class="meta" data-count aria-live="polite">{num(total)} documents</p>
    </header>
    <form class="facets" data-filters data-shelf={shelf.id} data-total={total} data-cloth={cloth}>
      <label class="find"><I name="filter" /><input type="search" name="q" placeholder="Title or author" aria-label="Filter by title or author" autocomplete="off" /></label>
      {picks.map((p) => (
        <>
          <input type="hidden" name={p.name} value="" />
          <button type="button" class="btn pick" data-open={`menu-${p.name}`} data-pick={p.name} data-label={p.label} aria-haspopup="menu"><span>{p.label}</span><I name="expand" /></button>
        </>
      ))}
    </form>
    <div class="flist rows" data-rows set:html={shelf.docs.slice(0, FIRST).map((d) => rowHtml(toRow(d), cloth)).join('')} />
    {total > FIRST && <p><button class="btn more" data-more>More</button></p>}
  </div>
  {picks.map((p) => (
    <section class="layer" id={`menu-${p.name}`} data-layer="tool" data-shape="menu" hidden aria-label={p.label}>
      <div class="grab"></div>
      <div class="body menu-rows" role="menu" data-menu={p.name}>
        <button type="button" role="menuitemradio" aria-checked="true" data-value=""><I name="check" class="sm" /><span class="k">Any</span></button>
        {p.options.map(([value, label, count]) => <button type="button" role="menuitemradio" aria-checked="false" data-value={value}><I name="check" class="sm" /><span class="k">{label}</span><span class="n">{num(count)}</span></button>)}
      </div>
    </section>
  ))}
</Base>

<script>
  import { matches, rowHtml, type Filter, type Row } from '../../lib/catalogue';
  import { closeLayer } from '../../lib/ui';

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const rows = document.querySelector<HTMLElement>('[data-rows]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const FIELDS = ['q', 'publisher', 'kind', 'year', 'read'] as const;
  const STEP = 200;
  const cloth = form.dataset.cloth!;
  let catalogue: Promise<Row[]> | undefined;
  let shown = rows.children.length;
  const num = (x: number) => x.toLocaleString('en');

  const filter = (): Filter => {
    const data = new FormData(form);
    return Object.fromEntries(FIELDS.map((f) => [f, String(data.get(f) ?? '').trim()])) as unknown as Filter;
  };
  async function draw(limit: number) {
    catalogue ??= fetch(`/catalogue/${form.dataset.shelf}.json`).then((r) => r.json());
    const f = filter();
    const found = (await catalogue).filter((row) => matches(row, f));
    shown = Math.min(limit, found.length);
    rows.innerHTML = found.slice(0, shown).map((row) => rowHtml(row, cloth)).join('');
    count.textContent = found.length ? `${num(found.length)} ${found.length === 1 ? 'document' : 'documents'}` : 'No matches';
    if (more) more.parentElement!.hidden = shown >= found.length;
    const params = new URLSearchParams(Object.entries(f).filter(([, v]) => v));
    history.replaceState(history.state, '', location.pathname + (params.size ? `?${params}` : ''));
  }

  // a pick names its choice, inverted once one is chosen
  function choose(name: string, value: string) {
    const input = form.elements.namedItem(name) as HTMLInputElement | null;
    const pick = form.querySelector<HTMLElement>(`[data-pick="${name}"]`);
    const menu = document.querySelector<HTMLElement>(`[data-menu="${name}"]`);
    if (!input || !pick || !menu) return;
    input.value = value;
    let label = pick.dataset.label!;
    menu.querySelectorAll<HTMLElement>('[data-value]').forEach((row) => {
      const on = row.dataset.value === value;
      row.setAttribute('aria-checked', String(on));
      if (on && value) label = row.querySelector('.k')!.textContent!;
    });
    pick.querySelector('span')!.textContent = label;
    pick.classList.toggle('chosen', !!value);
  }
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) =>
    menu.addEventListener('click', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (!row) return;
      choose(menu.dataset.menu!, row.dataset.value!);
      closeLayer();
      draw(STEP);
    }),
  );

  let timer = 0;
  form.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => draw(STEP), 120);
  });
  form.addEventListener('submit', (event) => event.preventDefault());
  more?.addEventListener('click', () => draw(shown + STEP));

  // A link such as /library/labs?publisher=Anthropic opens with the filter set.
  const params = new URLSearchParams(location.search);
  let preset = false;
  for (const name of FIELDS) {
    const value = params.get(name);
    if (!value) continue;
    if (name === 'q') (form.elements.namedItem('q') as HTMLInputElement).value = value;
    else choose(name, value);
    preset = true;
  }
  if (preset) draw(STEP);
</script>
