---
import Base from '../layouts/Base.astro';
---
<Base title="Not in the library" name="Not in the library">
  <div class="page">
    <header class="head">
      <h1>Not in the library</h1>
      <div class="ctl"><a class="btn" href="/library"><span>Library</span></a></div>
    </header>
  </div>
</Base>
<script>
  // A range such as /d/arxiv/2305.15324/v2/p6-p8 opens the reader at its first page.
  const m = /^(\/d\/[^/]+\/[^/]+\/[vr]\d+\/)([pb])(\d+)-[pb]?(\d+)\/?$/.exec(location.pathname);
  if (m) {
    const params = new URLSearchParams(location.search);
    params.set('end', m[2] + m[4]);
    location.replace(`${m[1]}${m[2]}${m[3]}?${params}`);
  }
</script>
