---
// Home: one screen. The name, the composer (Search, or Check a paragraph's citations), and a
// wall of first pages from the library running off the bottom edge.
import Base from '../layouts/Base.astro';
import I from '../components/I.astro';
import { getDoc, libraryCounts } from '../lib/data';
import { citePath } from '../lib/cite';
import { CHECK_EXAMPLE, CHECK_TERMS, GRAMMAR, GRAMMAR_SMALL, big } from '../lib/grammar';
import { WALL, wallFile } from '../lib/wall';
import fs from 'node:fs';

const grammar = big(libraryCounts().documents) ? GRAMMAR : GRAMMAR_SMALL;
const wall = WALL.map((id) => getDoc(id)).filter((d) => d && d.tier === 'open' && fs.existsSync(`public${wallFile(d.doc_id)}`))
  .map((d) => ({ href: citePath(d!.doc_id), src: wallFile(d!.doc_id), title: d!.title }));
---
<Base room="home" name="Home">
  <section class="hero">
    <h1>SafetyPage</h1>
    <form class="composer" id="composer" data-mode="search" role="search" action="/search" method="get">
      <div class="cbox">
        <textarea id="q" name="query" rows="1" placeholder="Search" aria-label="Search" autocomplete="off" enterkeyhint="search"></textarea>
        <button class="send" type="submit" aria-label="Send"><I name="send" /></button>
      </div>
      <div class="crow">
        <div class="seg" role="radiogroup" aria-label="Mode">
          <button type="button" role="radio" aria-checked="true" data-mode="search">Search</button>
          <button type="button" role="radio" aria-checked="false" data-mode="check">Check</button>
        </div>
        <button class="cbtn" type="button" data-open="help" aria-label="How to use it"><I name="help" /></button>
        <button class="btn eg" type="button" id="eg" hidden>Example</button>
      </div>
    </form>
  </section>
  {wall.length > 0 && <div class="wall" id="wall" data-wall={JSON.stringify(wall)}><div class="backs" aria-hidden="true"></div><div class="track"></div></div>}

  <section class="layer" id="help" data-layer="tool" hidden aria-label="How to use it">
    <div class="grab"></div>
    <div class="body">
      <dl class="grammar" id="grammar">
        {grammar.map(([q, what]) => <><dt><a class="exq" href={`/search?query=${encodeURIComponent(q)}`}>{q}</a></dt><dd>{what}</dd></>)}
      </dl>
      <dl class="grammar terms" id="about-check" hidden>
        {CHECK_TERMS.map(([term, what]) => <><dt>{term}</dt><dd>{what}</dd></>)}
      </dl>
    </div>
  </section>
  <template id="check-example">{CHECK_EXAMPLE}</template>
</Base>

<script>
  import { grow } from '../lib/grow';
  const form = document.querySelector<HTMLFormElement>('#composer')!;
  const box = form.querySelector<HTMLTextAreaElement>('textarea')!;
  const eg = document.getElementById('eg')!;
  const fit = () => { grow(box, form.dataset.mode === 'check' ? { min: 3, max: 8 } : { min: 1, max: 1 }); form.classList.toggle('typed', !!box.value.trim()); };
  const mode = (m: string) => {
    form.dataset.mode = m;
    form.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.mode === m)));
    box.placeholder = m === 'check' ? 'Check a paragraph' : 'Search';
    box.setAttribute('aria-label', box.placeholder);
    eg.hidden = m !== 'check';
    document.getElementById('grammar')!.hidden = m === 'check';
    document.getElementById('about-check')!.hidden = m !== 'check';
    document.body.classList.toggle('asking', m === 'check');
    fit();
  };
  form.querySelectorAll<HTMLElement>('.seg [data-mode]').forEach((b) => b.addEventListener('click', () => { mode(b.dataset.mode!); box.focus(); }));
  box.addEventListener('input', fit);
  box.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !(event.shiftKey && form.dataset.mode === 'check')) { event.preventDefault(); form.requestSubmit(); }
  });
  eg.addEventListener('click', () => { box.value = document.querySelector<HTMLTemplateElement>('#check-example')!.content.textContent!; fit(); box.focus(); });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = box.value.trim();
    if (!text) return;
    location.href = form.dataset.mode === 'check' ? `/check?text=${encodeURIComponent(text)}` : `/search?query=${encodeURIComponent(text)}`;
  });
  addEventListener('resize', fit);
  fit();

  // The wall: columns drifting in alternating directions, paused on hover, still under reduced motion.
  const wall = document.getElementById('wall');
  if (wall) {
    const pages = JSON.parse(wall.dataset.wall!) as { href: string; src: string; title: string }[];
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const list = pages.map((p) => [Math.random(), p] as const).sort((a, b) => a[0] - b[0]).map(([, p]) => p);
    const draw = () => {
      if (!wall.clientWidth) return;
      const phone = innerWidth < 720, colw = phone ? 104 : 164, gap = phone ? 12 : 18, per = 5;
      const cols = Math.ceil(wall.clientWidth / (colw + gap)) + 1;
      if (wall.dataset.cols === String(cols)) return;
      wall.dataset.cols = String(cols);
      wall.style.setProperty('--colw', colw + 'px');
      wall.style.setProperty('--gap', gap + 'px');
      let k = 0, covers = '', backs = '';
      for (let c = 0; c < cols; c++) {
        let once = '';
        for (let i = 0; i < per; i++) {
          const p = list[k++ % list.length];
          once += `<a class="wcover" href="${esc(p.href)}" title="${esc(p.title)}"><img alt="" decoding="async" fetchpriority="low" src="${esc(p.src)}" onload="this.classList.add('in')" onerror="this.closest('a').classList.add('gone')"></a>`;
        }
        const dur = (per * (colw * 1.3 + gap)) / (10 + ((c * 5) % 7));
        const col = `class="col${c % 2 ? ' down' : ''}" style="--dur:${dur.toFixed(1)}s;--delay:-${(Math.random() * dur).toFixed(1)}s"`;
        covers += `<div ${col}>${once}${once.replace(/<a /g, '<a tabindex="-1" aria-hidden="true" ')}</div>`;
        backs += `<div ${col}>${'<i></i>'.repeat(per * 2)}</div>`;
      }
      wall.querySelector('.track')!.innerHTML = covers;
      wall.querySelector('.backs')!.innerHTML = backs;
    };
    draw();
    let t = 0;
    new ResizeObserver(() => { clearTimeout(t); t = window.setTimeout(draw, 200); }).observe(wall);
  }
</script>
