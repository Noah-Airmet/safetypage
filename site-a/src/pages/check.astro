---
import Base from '../layouts/Base.astro';
import Checker from '../islands/Checker.tsx';
import Chip from '../components/Chip.astro';
import { CHECK_EXAMPLE } from '../lib/grammar';
---
<Base title="Check a quote" place="Check a quote" room="place" description="Paste text with citations and see each one marked Verified, Page only or Rejected, with the page.">
  <div class="page narrow">
    <header class="head"><h1>Check a quote</h1></header>
    <Checker client:load example={CHECK_EXAMPLE} />
  </div>
  <section class="layer" id="check-help" data-layer="tool" hidden aria-label="What is checked">
    <div class="grab"></div>
    <div class="body">
      <p class="exq">"the quoted words" (arxiv:2305.15324/v2/p6)</p>
      <dl class="grammar terms">
        <dt><Chip state="verified" label="Shevlane et al. 2023 · p. 6" /></dt><dd>Verified</dd>
        <dt><Chip state="cited" label="Shevlane et al. 2023 · p. 6" /></dt><dd>Page only</dd>
        <dt><Chip state="rejected" label="Shevlane et al. 2023 · p. 6" /></dt><dd>Rejected</dd>
      </dl>
    </div>
  </section>
</Base>
