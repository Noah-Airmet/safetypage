---
// /d/<ns>/<id>             the record page, latest version
// /d/<ns>/<id>/<version>   an older version's record page. The latest version's address is not
//                          built: the host serves /d/<ns>/<id> for it (one page per document).
// A page or paragraph (/d/<ns>/<id>/<version>/<anchor>) is not built here: the reader's shell
// (reader.astro) serves every one of them.
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import { allDocs } from '../../lib/data';
import { licenceName, shortLabel } from '../../lib/cite';
import { DATA_BASE } from '../../lib/env';
import type { DocumentCard } from '../../lib/types';

export function getStaticPaths() {
  const paths: { params: { path: string }; props: { doc: DocumentCard; version: string } }[] = [];
  for (const doc of allDocs()) {
    const stem = doc.doc_id.replace(':', '/');
    paths.push({ params: { path: stem }, props: { doc, version: doc.version } });
    for (const v of doc.versions) if (v.version !== doc.version) paths.push({ params: { path: `${stem}/${v.version}` }, props: { doc, version: v.version } });
  }
  return paths;
}

const { doc, version } = Astro.props;
const tier = doc.versions.find((v) => v.version === version)!.tier;
const description = `${shortLabel(doc)}. ${tier === 'open' ? 'Read here' : 'Read at source'} · ${licenceName(doc.licence)}.`;
// An open PDF's preview card is its first page.
const og = tier === 'open' && doc.anchor_kind === 'page' && version === doc.version && /^https?:/.test(DATA_BASE)
  ? `${DATA_BASE}/pages/${doc.doc_id.replace(':', '/')}/${version}/p1.800.webp` : undefined;
---
<Base title={doc.title} name={shortLabel(doc)} description={description} og={og} canonical={`/d/${doc.doc_id.replace(':', '/')}`}>
  <Record doc={doc} version={version} />
</Base>
