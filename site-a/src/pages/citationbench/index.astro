---
// The leaderboard, read from CitationBench's results files (one per run). Every number links to
// the run it came from, every run lists its questions, and every question opens its replay.
import Base from '../../layouts/Base.astro';
import I from '../../components/I.astro';
import { allRuns } from '../../lib/data';
import type { Estimate, RunResult } from '../../lib/types';

const runs = allRuns();
const COLUMNS = [
  { key: 'correct', label: 'Correct', judge: false },
  { key: 'page_precision', label: 'Page precision', judge: false },
  { key: 'quote_fidelity', label: 'Quote fidelity', judge: false },
  { key: 'support_rate', label: 'Claim support', judge: true },
];
const pct = (x: number | null | undefined) => (x == null ? '–' : String(Math.round(x * 100)));
// No interval is printed when the bootstrap gave none (a handful of questions from one or two documents).
const half = (e: Estimate) => (e.ci_low == null || e.ci_high == null || e.ci_high === e.ci_low ? null : Math.round(((e.ci_high - e.ci_low) / 2) * 100));
// A rank band from the intervals on Correct: a run shares a band with every run it overlaps.
const band = (run: RunResult) => {
  const me = run.measures.correct;
  const better = runs.filter((r) => (r.measures.correct.ci_low ?? 0) > (me.ci_high ?? 0)).length;
  const notWorse = runs.filter((r) => (r.measures.correct.ci_high ?? 0) >= (me.ci_low ?? 0)).length;
  return better + 1 === notWorse ? `${notWorse}` : `${better + 1}–${notWorse}`;
};
const judges = [...new Map(runs.filter((r) => r.judge).map((r) => [r.judge!.id, r.judge!])).values()];
const updated = runs.map((r) => r.created_at.slice(0, 10)).sort().at(-1);
const small = runs.some((r) => r.samples < 50);
const day = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="CitationBench" place="CitationBench" room="place" description="A benchmark of page-level citation: does an agent cite the right page, quote it accurately, and make claims the page supports?">
  <div class="page bench">
    <header class="head">
      <h1>CitationBench</h1>
      <p class="meta facts">{runs.length === 0 ? 'Empty' : <>{runs.length} {runs.length === 1 ? 'run' : 'runs'} · {day(updated!)}{small && <> · <span class="flag">Early runs</span></>}</>}</p>
      <div class="ctl">
        <button class="btn" type="button" data-open="bench-help" aria-haspopup="dialog"><I name="help" /><span>Measures</span></button>
        <a class="btn" href="https://github.com/Noah-Airmet/safetypage/tree/main/citationbench" rel="noopener"><I name="external" /><span>Questions and harness</span></a>
      </div>
    </header>

    {runs.length > 0 && (
      <div class="scroll" tabindex="0" role="region" aria-label="Results">
        <table class="board">
          <thead>
            <tr>
              <th>Rank</th><th>Agent</th>
              {COLUMNS.map((c) => <th class="num">{c.label}{c.judge && <span class="flag">Judge</span>}</th>)}
              <th class="num">$ per correct</th>
              <th class="num">Questions</th>
            </tr>
          </thead>
          <tbody>
            {runs.map((run) => {
              const href = `/citationbench/runs/${run.run_id}`;
              const cost = run.cost.per_correct_usd.mean;
              return (
                <tr>
                  <td class="rank">{band(run)}</td>
                  <td class="agent"><a href={href}><span class="model">{run.model.split('/').pop()}</span><span class="solver">{run.solver.replace(/ \(.*\)$/, '')} · {run.snapshot}</span></a></td>
                  {COLUMNS.map((col) => {
                    const e = run.measures[col.key];
                    return (
                      <td class="num"><a href={href} title={e?.mean == null ? undefined : `${pct(e.ci_low)}–${pct(e.ci_high)} · n ${e.n}`}>
                        <span class="v">{pct(e?.mean)}{e && half(e) != null && <span class="pm"> ±{half(e)}</span>}</span>
                        <span class="gauge" aria-hidden="true">{e?.mean != null && <><i class="ci" style={`left:${(e.ci_low ?? e.mean) * 100}%;width:${((e.ci_high ?? e.mean) - (e.ci_low ?? e.mean)) * 100}%`}></i><i class="at" style={`width:${e.mean * 100}%`}></i></>}</span>
                      </a></td>
                    );
                  })}
                  <td class="num"><a href={href}><span class="v">{cost == null || !run.cost.priced ? '–' : cost < 0.1 ? `$${cost.toFixed(3)}` : `$${cost.toFixed(2)}`}</span></a></td>
                  <td class="num"><a href={href}><span class="v">{run.samples}</span></a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
  <section class="layer" id="bench-help" data-layer="tool" hidden aria-label="Measures">
    <div class="grab"></div>
    <div class="body">
      <dl class="grammar terms">
        <dt>Correct</dt><dd>Right verdict, a gold page cited, no citation rejected.</dd>
        <dt>Page precision</dt><dd>Cited pages that are gold pages.</dd>
        <dt>Quote fidelity</dt><dd>Quoted words that are on the cited page.</dd>
        <dt>Claim support <span class="flag">Judge</span></dt><dd>{judges.length ? judges.map((j) => j.id.split('#')[0]).join(', ') : 'A model'} reads the page against the claim.</dd>
        <dt>Rank</dt><dd>A band: runs whose 95% intervals on Correct overlap share it.</dd>
      </dl>
    </div>
  </section>
</Base>
