---
// /follow/<topic>: one evaluation or topic across the labs' system and model cards. A saved
// search, laid out by lab and date; every row is a citation.
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import I from '../../components/I.astro';
import { TOPICS, follow, sectionOf, type Followed } from '../../lib/follow';
import { anchorLabel, citePath, formatDate, titleParts } from '../../lib/cite';
import type { Hit } from '../../lib/types';

export async function getStaticPaths() {
  return Promise.all(TOPICS.map(async (topic) => ({ params: { topic: topic.id }, props: { data: await follow(topic) } })));
}
const { data } = Astro.props as { data: Followed };
const { topic, labs } = data;
const query = topic.queries[0];
const y0 = Number(data.from), y1 = Number(data.to) + 1;
// Where a date falls on the strip, as a percentage of its width.
const at = (published: string) => {
  const [y, m = 7, d = 1] = published.split('-').map(Number);
  return (((y + (m - 1) / 12 + (d - 1) / 365 - y0) / (y1 - y0)) * 100).toFixed(2);
};
const years = Array.from({ length: y1 - y0 }, (_, i) => y0 + i);
const parts = (hit: Hit) => {
  const out: (string | { mark: string })[] = [];
  let i = 0;
  for (const [s, e] of hit.match_spans) {
    if (s < i) continue;
    out.push(hit.snippet.slice(i, s), { mark: hit.snippet.slice(s, e) });
    i = e;
  }
  out.push(hit.snippet.slice(i));
  return out;
};
const shown = labs.filter((l) => l.found.length > 0);
const slug = (org: string) => `lab-${org.replace(/\W+/g, '-')}`;
---
<Base title={`${topic.name} across the labs' system cards`} name={topic.name} description={`${data.found} of ${data.cards} system and model cards mention it. Each mention opens the page.`}>
  <div class="page follow">
    <header class="head">
      <nav class="crumbs" aria-label="Up"><a href="/follow">Follow a topic</a><I name="forward" /></nav>
      <h1>{topic.name}</h1>
      <p class="meta">{data.found} of {data.cards} system cards</p>
      <div class="ctl facts">
        {topic.queries.map((q) => <a class="btn" href={`/search?query=${encodeURIComponent(q)}&kind=system_card`}><I name="search" /><span class="mono">{q}</span></a>)}
      </div>
    </header>

    {data.from && (
      <div class="strip" role="img" aria-label={`Each lab's cards by date from ${data.from} to ${data.to}. A lit mark is a card that mentions ${topic.name.toLowerCase()}: ${shown.map((l) => `${l.org}, ${l.found.length} of ${l.found.length + l.silent.length}`).join('; ')}.`}>
        {labs.map((lab) => (
          <div class="lane">
            <span class="lab">{lab.org}</span>
            <span class="track">
              {lab.silent.filter((d) => d.published).map((d) => <i style={`left:${at(d.published!)}%`} />)}
              {lab.found.filter((f) => f.doc.published).map((f) => <i data-found style={`left:${at(f.doc.published!)}%`} />)}
            </span>
            <span class="of">{lab.found.length} / {lab.found.length + lab.silent.length}</span>
          </div>
        ))}
        <div class="lane axis"><span class="lab"></span><span class="track">{years.map((y) => <span style={`left:${at(String(y) + '-01')}%`}>{y}</span>)}</span><span class="of"></span></div>
      </div>
    )}

    {shown.length === 0 && <p class="none">No matches</p>}
    {labs.map((lab) => (
      <section class="sec lab-section" id={slug(lab.org)} aria-labelledby={`${slug(lab.org)}-h`}>
        <h2 id={`${slug(lab.org)}-h`}>{lab.org}<small>{lab.found.length} of {lab.found.length + lab.silent.length}</small></h2>
        <ol class="hits cards">
          {lab.found.map(({ doc, hits, count }) => {
            const { main, sub } = titleParts(doc.title);
            const sect = hits[0] && (hits[0].anchor[0] === 'p' ? sectionOf(doc, hits[0]) : hits[0].anchor_label.replace(/\s*¶\d+$/, ''));
            return (
              <li class="res">
                <Cover doc={doc} />
                <div class="rb">
                  <a class="rt name" href={hits[0] ? citePath(hits[0].cite) : citePath(doc.doc_id)}>{main}{sub && <span class="sub">: {sub}</span>}</a>
                  <span class="rm">{[formatDate(doc.published).replace(/^\d+ /, ''), doc.tier === 'open' ? null : 'Read at source'].filter(Boolean).join(' · ')}</span>
                  {hits[0] && <p class="rs snippet">{parts(hits[0]).map((p) => (typeof p === 'string' ? p : <mark>{p.mark}</mark>))}</p>}
                  <span class="chips">
                    {hits.map((hit, i) => <a class="hit" href={citePath(hit.cite)}>{i === 0 ? anchorLabel(hit.anchor) : anchorLabel(hit.anchor).replace(/^p\. /, '')}</a>)}
                    {count > hits.length && <a class="rest" href={`/search?query=${encodeURIComponent(query)}&doc=${encodeURIComponent(doc.doc_id)}`}>+{count - hits.length}</a>}
                    {sect && <span class="sect">{sect}</span>}
                  </span>
                </div>
              </li>
            );
          })}
        </ol>
        {lab.silent.length > 0 && (
          <details class="silent">
            <summary class="btn"><span>{lab.silent.length} without</span><I name="expand" /></summary>
            <div class="flist">{lab.silent.map((d) => <a class="frow" href={citePath(d.doc_id)}><span class="ent"><span class="t">{d.title}</span></span><span class="x">{formatDate(d.published).replace(/^\d+ /, '')}</span></a>)}</div>
          </details>
        )}
      </section>
    ))}
  </div>
</Base>
