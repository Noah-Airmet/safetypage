---
// /q/<id>: one quote check with its page, and a preview card that says the verdict.
import Base from '../../layouts/Base.astro';
import PageCrop from '../../components/PageCrop.astro';
import Chip from '../../components/Chip.astro';
import I from '../../components/I.astro';
import { allChecks, type StoredCheck } from '../../lib/checks';
import { getDoc, getUnit } from '../../lib/data';
import { anchorLabel, anchorOf, citePath, docIdOf, shortLabel } from '../../lib/cite';
import { spanInUnit } from '../../lib/quote';

export const getStaticPaths = async () => (await allChecks()).map((check) => ({ params: { id: check.id }, props: { check } }));
const { check } = Astro.props as { check: StoredCheck };
const doc = getDoc(docIdOf(check.cite))!;
const here = anchorLabel(anchorOf(check.cite));
const shownAt = anchorLabel(anchorOf(check.shown));
const unit = getUnit(check.shown);   // open documents only: a link-only page has no published text
const range = unit && check.span ? spanInUnit(unit, check.span) : null;
const verdicts: Record<string, string> = {
  exact: `On ${here}, word for word`, normalized: `On ${here}, allowing for case, punctuation and line breaks`,
  elsewhere: `Not on ${here}. The words are on ${shownAt}`, near_miss: `Not on ${here}. The page says something else`, not_found: `Not on ${here}, or anywhere in the document`,
};
const flags: Record<string, string> = { exact: 'Word for word', normalized: 'Normalised', near_miss: 'The page says', not_found: 'Not in the document' };
const said = unit?.text && range ? unit.text.slice(range[0], range[1]).replace(/\s+/g, ' ') : null;
---
<Base title={`${check.passed ? 'Verified' : 'Rejected'}: “${check.quote.slice(0, 60)}”`} name="Quote check" place="Quote check" room="place" description={`${verdicts[check.verdict]}. ${doc.title}.`} og={`/og/q/${check.id}.png`}>
  <div class="page narrow qpage">
    <header class="head">
      <nav class="crumbs" aria-label="Up"><a href={citePath(doc.doc_id)}>{shortLabel(doc)}</a><I name="forward" /></nav>
      <h1 class="quote">“{check.quote}”</h1>
      <p class="why">
        <span class="state" data-state={check.passed ? 'verified' : 'rejected'}><I name={check.passed ? 'check' : 'close'} /><span>{check.passed ? `On ${here}` : `Not on ${here}`}</span></span>
        {check.verdict === 'elsewhere' ? <Chip state="verified" label={shownAt} href={citePath(check.shown, check.quote)} /> : <span class="flag">{flags[check.verdict]}</span>}
      </p>
      {!check.passed && said && <p class="says">“{said}”</p>}
    </header>
    {unit?.width && range && <PageCrop unit={unit} ranges={[range]} kind={check.passed ? 'found' : 'reject'} alt={`${doc.title}, ${shownAt}`} eager />}
    <div class="ctl">
      <a class="pill" href={citePath(check.shown, check.passed ? check.quote : undefined)}><I name="book" /><span>{shownAt}</span></a>
      <a class="btn" href={`/check?text=${encodeURIComponent(`"${check.quote}" (${check.cite})`)}`}><I name="quote" /><span>Check again</span></a>
    </div>
  </div>
</Base>
