---
import Base from '../../layouts/Base.astro';
import Tally from '../../components/Tally.astro';
import { allTraces } from '../../lib/data';
import { questionParts } from '../../lib/cite';
const traces = allTraces();
---
<Base title="Replays" name="Replays" place="Replays" room="place" description="Agent research runs, played back step by step against the library.">
  <div class="page">
    <header class="head">
      <h1>Replays</h1>
      <p class="meta">{traces.length} runs</p>
    </header>
    <div class="flist rows">
      {traces.map((t) => (
        <a class="frow two" href={`/r/${t.header.trace_id}`}>
          <span class="ent"><span class="t name">{questionParts(t.header.question).quoted ?? t.header.question}</span><span class="a"><Tally citations={t.answer?.citations ?? []} /></span></span>
          <span class="x">{t.header.model.split('/').pop()} · {t.header.started_at.slice(0, 10)}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
