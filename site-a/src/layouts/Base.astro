---
// The shell every room stands in: the bar's three zones (where you can go, where you are, what
// you can do here), the sidebar and its toggle. A room names itself with `place`; a browse room
// (`room="browse"`) has the search field in the bar's middle instead.
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/rooms.css';
import I from '../components/I.astro';
import { allShelves } from '../lib/data';
import { clothOf, shelfName, shelfOrder, shelfShort } from '../lib/cite';

interface Props { title?: string; description?: string; og?: string; canonical?: string; room?: 'home' | 'browse' | 'place' | 'reader'; place?: string; name?: string }
const { title, description = 'A library of the AI safety record. Every result opens the exact page, and every citation is checked against it.', og = '/og/site.png', canonical, room = 'browse', place, name } = Astro.props;
const fullTitle = title ? `${title} · SafetyPage` : 'SafetyPage: the AI safety record, cited to the page';
// A page is built as <address>.html; its address has no extension.
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const abs = (p: string) => new URL(p, Astro.site).href;
const at = (href: string) => (href === '/' ? here === '/' : here === href || here.startsWith(href + '/')) ? 'page' : undefined;
const top = [['/', 'home', 'Home'], ['/search', 'search', 'Search'], ['/library', 'book', 'Library'], ['/check', 'quote', 'Check a quote'], ['/follow', 'follow', 'Follow a topic']];
const foot = [['/citationbench', 'bench', 'CitationBench'], ['/r', 'replay', 'Replays'], ['/connect', 'connect', 'Connect an agent'], ['/about', 'about', 'About the library']];
const shelves = [...allShelves()].sort((a, b) => shelfOrder(a.id) - shelfOrder(b.id) || b.docs.length - a.docs.length);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(canonical ?? here)} />
    <meta property="og:site_name" content="SafetyPage" />
    <meta property="og:title" content={title ?? 'SafetyPage'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={abs(canonical ?? here)} />
    <meta property="og:image" content={abs(og)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(og)} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0D0D0C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // the sidebar, open or shut by one choice for every room, set before the first paint
      (function () {
        var wide = !matchMedia('(max-width: 720px)').matches, open = false;
        try { open = wide && localStorage.getItem('sp-sidebar') === 'open'; } catch (e) {}
        var c = document.documentElement.classList;
        if (wide) c.add('side-docked');
        if (open) c.add('side-open');
      })();
    </script>
  </head>
  <body class={room === 'place' ? 'named' : room} data-name={name ?? place ?? title}>
    <button class="ib" id="side-btn" type="button" aria-label="Sidebar" aria-controls="sidebar" aria-expanded="false"><I name="sidebar" /></button>
    <div id="scrim" hidden></div>
    <nav id="sidebar" class="frost" aria-label="Site">
      <div class="sb-scroll">
        {top.map(([href, glyph, label]) => <a class="row" href={href} aria-current={at(href)}><I name={glyph} /><span class="one">{label}</span></a>)}
        <h2>Shelves</h2>
        {shelves.map((s) => <a class="row" href={`/library/${s.id}`} aria-current={at(`/library/${s.id}`)} title={shelfName(s.id)}><span class="mark" style={`--cloth:${clothOf(s.id)}`}><i></i></span><span class="one">{shelfShort(s.id)}</span></a>)}
        <div id="sb-continue" hidden><h2>Continue</h2></div>
      </div>
      <div class="sb-foot">
        {foot.map(([href, glyph, label]) => <a class="row" href={href} aria-current={at(href)}><I name={glyph} /><span class="one">{label}</span></a>)}
      </div>
    </nav>

    <header class="bar">
      <div class="zone l"><span class="slot"></span><a class="back" href="/" hidden aria-label="Back"><span class="ib"><I name="back" /></span><span></span></a></div>
      <div class="zone m" id="bar-m">
        {room === 'browse' && (
          <form class="find" action="/search" role="search"><I name="search" /><input type="search" name="query" placeholder="Search the library" aria-label="Search the library" autocomplete="off" enterkeyhint="search" /></form>
        )}
        {place && <div class="place"><b>{place}</b></div>}
      </div>
      <div class="zone r" id="bar-r">
        <slot name="bar" />
        {room === 'place' && <a class="ib" href="/search" aria-label="Search"><I name="search" /></a>}
      </div>
      <i class="progress" id="progress"></i>
    </header>

    <main><slot /></main>
    <script>import '../scripts/shell.ts';</script>
  </body>
</html>
