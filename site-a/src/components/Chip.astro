---
// A citation. Verified is the accent with the drawn check; Page only is ink; Rejected is struck
// through. The state is said in words for screen readers.
import I from './I.astro';
interface Props { state: 'verified' | 'cited' | 'rejected'; label: string; href?: string }
const { state, label, href } = Astro.props;
const words = { verified: 'Verified', cited: 'Page only', rejected: 'Rejected' }[state];
const Tag = href ? 'a' : 'span';
---
<Tag class="cite chip" data-state={state} href={href}>{state === 'verified' && <I name="check" />}{state === 'rejected' && <I name="close" />}<span class="sr">{words}: </span><span class="chip-label">{label}</span></Tag>
