// Cloudflare: the built site as static assets, with worker.js in front of the few paths that
// are not files. See README.md in this folder.
{
  "name": "safetypage",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../site/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // A record page (/d/<ns>/<id>) is a file. Anything deeper under /d/ goes to the Worker: a
    // version's record, or a page or paragraph.
    "run_worker_first": ["/d/*/*/*", "/data/*", "/api/*", "/mcp", "/x/*"]
  },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "safetypage-data" }],
  "vars": { "API_ORIGIN": "https://api.example.org" }
}
